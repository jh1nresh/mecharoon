# PostgreSQL for the local sandbox. CLI scripts default to mecharoon_dev.
PGHOST=/tmp
PGPORT=5432
PGDATABASE=mecharoon_dev
MECHAROON_DB_POOL_MAX=5

# The one-click golden loop is deliberately disabled in production.
MECHAROON_DEMO_MODE=true

# Local scoped identities. Generate a distinct random value for every token.
MECHAROON_BUYER_ID=participant_demo_buyer
MECHAROON_BUYER_TOKEN=replace-with-distinct-random-buyer-token
MECHAROON_SELLER_ID=participant_demo_seller
MECHAROON_SELLER_TOKEN=replace-with-distinct-random-seller-token
MECHAROON_EVALUATOR_TOKEN=replace-with-distinct-random-evaluator-token
MECHAROON_OPERATOR_TOKEN=replace-with-distinct-random-operator-token
MECHAROON_DEMO_TOKEN=replace-with-a-distinct-random-demo-token

# Optional single-partner hosted sandbox. Keep this disabled until the managed
# PostgreSQL database has been migrated and the deployment secret is set.
# MECHAROON_HOSTED_SANDBOX_MODE=false
# MECHAROON_DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# MECHAROON_SANDBOX_PARTNER_ID=design_partner_01
# MECHAROON_SANDBOX_TOKEN=replace-with-at-least-32-random-characters
# MECHAROON_SANDBOX_DAILY_RUN_LIMIT=20

NEXT_PUBLIC_SITE_URL=http://localhost:3000
