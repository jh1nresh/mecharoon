{
  "name": "mecharoon",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "PGDATABASE=${PGDATABASE:-mecharoon_dev} tsx scripts/db-migrate.ts",
    "db:migrate:test": "PGDATABASE=mecharoon_test MECHAROON_MIGRATION_MODE=test tsx scripts/db-migrate.ts",
    "db:seed": "PGDATABASE=${PGDATABASE:-mecharoon_dev} tsx scripts/db-seed.ts",
    "db:reset:test": "PGDATABASE=mecharoon_test tsx scripts/db-reset-test.ts",
    "demo:run": "PGDATABASE=${PGDATABASE:-mecharoon_dev} tsx scripts/demo-run.ts",
    "test:unit": "tsx --test tests/core/*.test.ts",
    "test:integration": "PGDATABASE=mecharoon_test tsx --test --test-concurrency=1 tests/integration/*.test.ts",
    "test:concurrency": "PGDATABASE=mecharoon_test tsx --test --test-concurrency=1 tests/concurrency/*.test.ts",
    "test": "npm run db:migrate:test && npm run test:unit && npm run test:integration && npm run test:concurrency",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "brand:export": "node scripts/export-brand.mjs"
  },
  "dependencies": {
    "motion": "^12.35.0",
    "next": "16.2.11",
    "pg": "^8.22.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "sharp": "0.35.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3"
  }
}
